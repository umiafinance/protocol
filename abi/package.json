{
  "name": "@umia/abi",
  "version": "0.1.0",
  "description": "Typed ABIs and raw JSON exports for the Umia protocol smart contracts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiafinance/protocol.git"
  },
  "homepage": "https://github.com/umiafinance/protocol",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/contracts.ts",
    "src/generated.ts",
    "src/index.ts",
    "json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./json/*": "./json/*"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "codegen": "wagmi generate && bun run src/dump-json.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wagmi/cli": "catalog:",
    "typescript": "catalog:"
  }
}
